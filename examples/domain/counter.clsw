# Counter state is process-local and non-durable; recorded events are not delivered.
export context CounterContext {
  Counter;
  IncrementCounter;
  export CounterController;
}

aggregate Counter {
  identity id: (string) = "";
  field count: (number) = 0;

  command Increment: ({ id: string, by: number });
  event Incremented: ({ id: string, by: number, count: number });

  start state Ready {
    command Increment {
      emit Incremented: {
        id: input.id,
        by: input.by,
        count: (add state.fields.count input.by)
      };
    }
    event Incremented {
      set id = input.id;
      set count = input.count;
    }
  }
}

manager IncrementCounter {
  operation Increment {
    input: ({ id: string, by: number });
    result: (
      { kind: "accepted", events: any, version: number }
      | { kind: "rejected", reason: any }
      | { kind: "conflicted" }
      | { kind: "failed", error: string, mayHaveCommitted: boolean }
    );
    send Counter.Increment {
      identity: input.id;
      payload: input;
    }
  }
}

controller CounterController {
  route POST "/counters/{id}" public {
    operation IncrementCounter.Increment;
    path: ({ id: string });
    body: ({ by: number });
    input: { id: request.path.id, by: request.body.by };
  }
}

export config CounterSettings {
  mode: ("api");
}

export mode CounterApi: Web {
  controllers {
    CounterContext.CounterController http;
  }
}

export program CounterApplication {
  config CounterSettings settings;
  mode settings.mode {
    "api" => CounterApi;
  }
}
