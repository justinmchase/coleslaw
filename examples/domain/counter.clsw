# Design example: Types, rules, metadata, and event projections are not implemented yet.
# UUID, PositiveInteger, and NonNegativeInteger denote the specified common Types.
# Equivalently, count may be declared as: field count: 0 | PositiveInteger = 0;
rule IncrementMetadata = { reason: string };

export context CounterContext {
  counter: Counter;
  manager: CounterManager(counter);
  export http: CounterController(manager);
}

aggregate Counter {
  identity id: UUID;
  field count: NonNegativeInteger = 0;

  command Increment {
    input: { id: UUID, by: PositiveInteger };
    metadata: IncrementMetadata?;
  }

  event Incremented = Increment -> {
    id: input.id,
    by: input.by,
    count: (add state.fields.count input.by),
    reason: metadata.reason
  };

  start state Ready {
    command Increment {
      emit Incremented;
    }
    event Incremented {
      set count = input.count;
    }
  }
}

manager CounterManager(counter: Counter) {
  operation Increment {
    input: { id: UUID, by: PositiveInteger };
    result: (
      { kind: "accepted", events: any, version: number }
      | { kind: "rejected", reason: any }
      | { kind: "conflicted" }
      | { kind: "failed", error: string, mayHaveCommitted: boolean }
    );
    send counter.Increment {
      identity: input.id;
      payload: input;
    }
  }
}

controller CounterController(manager: CounterManager) {
  route POST "/counters/{id}" public {
    operation manager.Increment;
    path: { id: UUID };
    body: { by: PositiveInteger };
    input: { id: request.path.id, by: request.body.by };
  }
}

export config CounterSettings {
  mode: "api";
}

export mode CounterApi: Web {
  controllers {
    CounterContext.http http;
  }
}

export program CounterApplication {
  config CounterSettings settings;
  mode settings.mode {
    "api" => CounterApi;
  }
}
